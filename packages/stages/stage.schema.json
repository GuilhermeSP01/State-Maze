{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State Maze stage definition",
  "description": "Initial stage state. Tile codes: 0 = floor off, 1 = floor on, 2 = wall.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "worldId", "number", "map", "playerStart"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "worldId": {
      "description": "UUID of the world this stage belongs to.",
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "description": "Display number within the world. The pair (worldId, number) is unique.",
      "type": "integer",
      "minimum": 1
    },
    "map": {
      "description": "Rows of tile codes, indexed as map[row][column].",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "enum": [0, 1, 2]
        }
      }
    },
    "playerStart": {
      "description": "Player starting position, using zero-based coordinates.",
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column"],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
