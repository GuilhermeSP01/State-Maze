{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State Maze world definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "description": "Titles keyed by language code. English is the fallback.",
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
